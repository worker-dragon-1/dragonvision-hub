# Used by `vite --mode emulator` (npm run dev:emu). No real credentials. VITE_DIRECTOR_EMAIL must equal DIRECTOR_EMAIL() in firestore.rules.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-dragonvision-hub
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_DIRECTOR_EMAIL=m.abderrahmenmagdoud@gmail.com
