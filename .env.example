# ── Firebase web app config ────────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Director bootstrap ─────────────────────────────────────────────────────
# The ONE email that becomes "director" on first sign-in.
# MUST be identical (case-insensitive) to DIRECTOR_EMAIL() in firestore.rules.
VITE_DIRECTOR_EMAIL=director@example.com
